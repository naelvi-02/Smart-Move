{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "main-desktop",
  "description": "Desktop window permissions for Smart Move, including updater and process relaunch support.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/smart-move-backend",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ],
  "platforms": ["windows"]
}
